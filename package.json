{
  "name": "aburungo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "vite",
    "dev:api": "lsof -ti:3000 >/dev/null 2>&1 && echo 'Error: port 3000 is already in use — kill that process first' || pnpm --filter ./server run dev",
    "dev:server": "concurrently -n frontend,api -c cyan,magenta \"pnpm dev\" \"pnpm dev:api\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "walkthrough": "bash scripts/walkthrough.sh",
    "verify:persistence": "bash -c \"pnpm build && (pnpm exec vite preview --port 4173 --strictPort &) && until curl -fsS -o /dev/null http://localhost:4173/; do sleep 0.5; done && node scripts/verify-persistence.cjs; pkill -f \"vite preview\"\"",
    "typecheck": "tsc -b",
    "prepare": "git config core.hooksPath .githooks || true",
    "jlpt:fetch": "node scripts/jlpt.mjs fetch",
    "jlpt:build": "node scripts/jlpt.mjs build",
    "jlpt:coverage": "node scripts/jlpt.mjs coverage",
    "jlpt:sentences": "node scripts/jlpt.mjs sentences",
    "ladder": "node scripts/ladder.mjs",
    "ladder:open": "node scripts/ladder.mjs && open docs/book-one-ladder.html",
    "reading": "node scripts/reading.mjs",
    "aozora": "node scripts/aozora.mjs",
    "vocab": "node scripts/vocab.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "aburungo-design-system": "link:../aburungo-design-system",
    "dexie": "^4.4.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^7.15.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-yaml": "^4.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "js-yaml": "^4.1.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  }
}
