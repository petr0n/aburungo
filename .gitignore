/AburunGo Japanese learning app/
*.code-workspace

.local

# Large data files (JMdict, Tatoeba, etc.) — download locally, do not commit
server/data/

# Reading-pipeline intermediates — several MB, regenerated from server/data
# by `pnpm reading ingest|tag`. micro-readings.json stays committed.
data/reading/corpus.json
data/reading/tagged.json

# Railway generates a local lockfile when building in the server/ subdirectory;
# the root workspace pnpm-lock.yaml is authoritative
server/pnpm-lock.yaml

# Git worktrees and superpowers:subagent-driven-development scratch state
.claude/worktrees/
.superpowers/

# /learn walkthrough artifacts (screenshots, results.json, run logs)
scripts/.walkthrough-out/

# Supabase CLI scratch state — version probes, linked-project ref, pooler URL.
# Rewritten on every CLI invocation, so tracking it dirties the tree on every
# branch. No secrets: the anon key and project ref are public by design.
supabase/.temp/

# Aozora ingest: catalogue + downloaded texts, regenerable via pnpm aozora
data/aozora/

# Vocabulary authoring queues (data/jlpt/candidates-*) are committed, both
# formats. They are regenerable, but the point is reading them on a device that
# cannot run the generator -- so they live in the repo, not in a local scratch
# file. Regenerate with `pnpm vocab candidates <level>`.
