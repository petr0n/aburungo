      "味",
      "まず感じ",
      "苦い",
      "ろう"
     ],
     "unknownItemIds": []
    },
    {
     "jpn": "この国に住んで20年になるが、今でも紅茶を注文するとき必ず2つのことを尋ねる。",
     "coverage": 0.8,
     "coverageAllBooks": 0.88,
     "totalTokens": 25,
     "unknownRuns": [
