      "vocab.uketsukeru",
      "vocab.kangaeru",
      "vocab.kangae"
     ]
    },
    {
     "jpn": "多くの人は航空宇宙工学に私の未来はないと思っていました。",
     "coverage": 0.7,
     "coverageAllBooks": 0.75,
     "totalTokens": 20,
     "unknownRuns": [
