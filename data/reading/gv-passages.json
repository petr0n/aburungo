   "translator": "Moegi Tanaka",
   "proofreader": "Eiko Iwama",
   "gateFor": "b3.band-8",
   "chars": 269,
   "sentences": [
    {
     "jpn": "親戚や教師、まったくの他人から批判を受けるとは考えもしませんでした。",
     "coverage": 0.5556,
     "coverageAllBooks": 0.7778,
     "totalTokens": 18,
