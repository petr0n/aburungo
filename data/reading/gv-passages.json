      "vocab.hitsuyou"
     ]
    },
    {
     "jpn": "それは淹（い）れたてかどうか、また薄くしてもらえるかどうかである。",
     "coverage": 0.6364,
     "coverageAllBooks": 0.6364,
     "totalTokens": 22,
     "unknownRuns": [
