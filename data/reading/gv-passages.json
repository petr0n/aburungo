      "vocab.erabu",
      "vocab.kazu",
      "vocab.muda",
      "vocab.mono-person"
     ]
    },
    {
     "jpn": "しかし私はそんなことには耳を貸しませんでした。",
     "coverage": 0.8333,
     "coverageAllBooks": 0.9167,
     "totalTokens": 12,
     "unknownRuns": [
      "そん"
     ],
     "unknownItemIds": [
      "vocab.shikashi"
     ]
    },
    {
     "jpn": "私は自分に確信を持ち、絶対にやりたいことがわかっていましたから、何を言われても私の人生には影響しませんでした。",
     "coverage": 0.7273,
     "coverageAllBooks": 0.8485,
