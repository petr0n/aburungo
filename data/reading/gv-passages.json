     "totalTokens": 9,
     "unknownRuns": [
      "けれ",
      "苦すぎ"
     ],
     "unknownItemIds": []
    },
    {
     "jpn": "私のふるさとアゼルバイジャンでは、紅茶は澄んでいて軽やか。",
